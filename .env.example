# Canonical index of environment variables across the repo. This root file is a REFERENCE.
# Each runtime loads its own .env from the location noted below (all .env files are gitignored).

# --- agents/  (copy to agents/src/agents/address/.env — adk web auto-loads it there) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=your-project-id
# ADDRESS_AGENT_MODEL=gemini-3.7-flash
# BRIDGE_CARD_URL=http://127.0.0.1:8080/.well-known/agent-card.json
# BRIDGE_BASE_URL=http://127.0.0.1:8080

# --- mock Bridge server (agents/) — optional overrides ---
# MOCK_BRIDGE_HOST=127.0.0.1
# MOCK_BRIDGE_PORT=8080
# MOCK_BRIDGE_HOLD_SECONDS=10.0
# MOCK_BRIDGE_PARK=            # 1/true to exercise the INPUT_REQUIRED park tracer

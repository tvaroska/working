# Address agent — ADK dev UI (`adk web`) environment.
# Copy to `.env` (gitignored) in this folder; `adk web` loads it automatically.

# Route Gemini through Vertex AI (day-one platform bet, ADR-0001).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
# Your Vertex AI project (no default — set it):
GOOGLE_CLOUD_PROJECT=your-project-id

# Optional overrides:
# BRIDGE_CARD_URL=http://127.0.0.1:8080/.well-known/agent-card.json
# BRIDGE_BASE_URL=http://127.0.0.1:8080
